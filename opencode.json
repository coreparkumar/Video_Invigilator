{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "python -m pytest*": "allow",
      "python tools/audio_selftest.py*": "allow",
      "python -m py_compile*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "pip install*": "ask",
      "git push*": "deny",
      "git reset --hard*": "deny",
      "curl*": "deny",
      "wget*": "deny",
      "rm -rf*": "deny",
      "rmdir /s*": "deny"
    },
    "webfetch": "deny"
  }
}